[Unit]
Description=AI Swap Predictor Daemon (V3)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/swap_ai_daemon
ExecStart=/usr/bin/python3 /opt/swap_ai_daemon/daemon_main.py /opt/swap_ai_daemon/models_v3/gru_slices_v3_best.keras
Restart=on-failure
RestartSec=1
# Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
